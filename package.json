{
  "name": "battlebots-arena",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify:multiplayer": "tsx scripts/verify-multiplayer.ts",
    "verify:models": "tsx scripts/verify-models.ts",
    "verify:damage-models": "tsx scripts/verify-damage-models.ts",
    "verify:life-bars": "tsx scripts/verify-life-bars.ts",
    "verify:damage-network": "tsx scripts/verify-damage-network.ts",
    "verify:arena": "tsx scripts/verify-arena.ts",
    "verify:arena-network": "tsx scripts/verify-arena-network.ts",
    "verify:load": "tsx scripts/verify-load.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.33.2",
    "@colyseus/core": "0.18.26",
    "@colyseus/sdk": "0.18.9",
    "@colyseus/ws-transport": "0.18.4",
    "@dimforge/rapier3d-compat": "0.21.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.27.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
